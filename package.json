{
  "name": "math-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "VITE_BASE=/math-review/ pnpm build",
    "deploy:ecs": "bash deploy/deploy_ecs.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "vue-tsc -b",
    "verify:ecs": "bash deploy/verify_ecs.sh"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
